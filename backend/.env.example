# Copie este arquivo para .env e ajuste os valores se necessário.

# Desenvolvimento (padrão)
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Banco: deixe vazio para usar SQLite local.
# Em produção (Render), use a Internal Database URL do PostgreSQL.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_SSL_REQUIRE=True

# Produção (exemplo Render) — configure no painel, não no Git:
# DEBUG=False
# SECRET_KEY=<chave-longa-e-aleatoria>
# ALLOWED_HOSTS=.onrender.com,seu-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://seu-frontend.vercel.app,http://localhost:5173
# DATABASE_URL=<internal-database-url>
# DATABASE_SSL_REQUIRE=True
# SECURE_SSL_REDIRECT=True
